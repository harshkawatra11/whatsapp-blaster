# HTTP port for local/dev use. The packaged Electron app overrides this to
# an OS-assigned free port automatically — this only matters when running
# `node server.js` directly.
PORT=3000

# Everything else is configured from the app itself and stored in the local
# SQLite database, not here: sending speed is chosen as a profile (Cautious /
# Balanced / Fast) from the ⚙ Settings panel, and the message template,
# poster and default country code are edited in Step 1. There is no database
# connection string to set: the app opens its own local .sqlite3 file
# automatically.
