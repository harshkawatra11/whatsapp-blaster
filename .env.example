# HTTP port for local/dev use. The packaged Electron app overrides this to
# an OS-assigned free port automatically — this only matters when running
# `node server.js` directly.
PORT=3000

# Everything else (pacing, daily cap, default country code) is configured
# from the app's Settings panel and stored in the local SQLite database —
# not here. There is no database connection string to set: the app opens
# its own local .sqlite3 file automatically.
