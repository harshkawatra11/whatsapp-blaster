{
  "name": "whatsapp-blaster",
  "version": "1.5.1",
  "private": true,
  "description": "Bulk WhatsApp invite automation, driving WhatsApp Desktop directly",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always",
    "mac:doctor": "node scripts/mac-doctor.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.whatsappblaster.app",
    "productName": "WhatsApp Blaster",
    "files": [
      "main.js",
      "server.js",
      "config.js",
      "template.js",
      "update-status.js",
      "platform-status.js",
      "db/**/*",
      "wa/**/*",
      "public/**/*",
      "build/icon.ico",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "WhatsApp Blaster needs to send keystrokes to WhatsApp to open chats and paste your message."
      }
    },
    "dmg": {
      "window": { "width": 540, "height": 400 },
      "contents": [
        { "x": 140, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" },
        { "x": 270, "y": 340, "path": "build/dmg-readme.txt" }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "harshkawatra11",
      "repo": "whatsapp-blaster"
    }
  }
}
